  "description": "Express-based backend API for the Personal Expense Tracker application.",
  "main": "app.js",
  "scripts": {
    "dev": "nodemon src/app.js",
    "migrate:up": "node src/db/run.js migrate:up",
    "migrate:down": "node src/db/run.js migrate:down",
    "seed:up": "node src/db/run.js seed:up",
    "seed:down": "node src/db/run.js seed:down",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "jest --watchAll"
  },
  "jest": {
